---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Steps from '~/components/widgets/Steps.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getSiteUrl } from '~/utils/site-url';
import { ORGANIZATION_ID } from '~/utils/organization-schema';
import { BREADCRUMB_HOME, BREADCRUMB_OEM, buildBreadcrumbList } from '~/utils/breadcrumb-schema';

const siteUrl = getSiteUrl();
const pagePath = '/oem';
const quoteHref = '/contact?looking=OEM%2FPrivate%20label#inquiry-form';

const metadata = {
  title: 'Private Label Creatine OEM | Gummies, Powder & Capsules',
  description:
    'Private label creatine manufacturer — creatine monohydrate gummies, powder, and capsules OEM. Starting configs, custom flavors and packaging, samples, MOQ guidance, COA support. Request an OEM quote.',
  ignoreTitleTemplate: true,
};

const faqItems = [
  {
    title: 'What is your typical OEM MOQ?',
    description:
      'MOQ depends on format, flavor count, and packaging. <strong>Gummy</strong> trial/program MOQs commonly start around <strong>1,000 units</strong> for standard bottle programs (customized packaging often higher). <strong>Powder</strong> private-label trials often fall in the <strong>500–1,000 unit</strong> range; <strong>capsule</strong> programs commonly start around <strong>1,000 bottles</strong> (higher for some full custom runs). Final tiers confirmed on quote.',
  },
  {
    title: 'What gummy dose architectures do you offer?',
    description:
      'Two common starting configurations: <strong>~1,000 mg creatine monohydrate per gummy</strong>, or <strong>~5 g creatine across a 3-gummy daily serving</strong> (e.g. 90-count ≈ 30 servings). Final serving size is locked on the approved formula and label.',
  },
  {
    title: 'Can you do private label creatine gummies?',
    description:
      'Yes. We offer <strong>private label creatine gummies</strong> with pectin-based / gelatin-free options where formula supports, sugar-free (0 g sugar; polyols may apply), flavor development, and PET bottle / doypack / sachet packaging — alongside powder and capsule programs.',
  },
  {
    title: 'Do you offer creatine capsules?',
    description:
      'Yes. Capsule programs typically fill approx. <strong>750–1,000 mg</strong> per capsule with bottle counts such as 60 / 90 / 120 / 180 / 240. Shell options include gelatin, HPMC, or pullulan subject to program. Multiple capsules may be needed for a 3–5 g serving — final serving on the approved label.',
  },
  {
    title: 'Will you help with labels and claims review?',
    description:
      'We can share manufacturing and documentation context for your regulatory review. We do <strong>not</strong> make disease-treatment claims; US partners remain responsible for DSHEA-compliant labeling.',
  },
];

const breadcrumbSchema = buildBreadcrumbList([
  { name: BREADCRUMB_HOME.en, path: '/' },
  { name: BREADCRUMB_OEM.en, path: pagePath },
]);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(({ title, description }) => ({
    '@type': 'Question',
    name: title,
    acceptedAnswer: { '@type': 'Answer', text: description.replace(/<[^>]+>/g, '') },
  })),
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="OEM / Private Label"
    actions={[
      { variant: 'primary', text: 'Start OEM project', href: quoteHref, icon: 'tabler:send' },
      { text: 'View product programs', href: '/products' },
      { text: 'View wholesale', href: '/wholesale' },
    ]}
  >
    <Fragment slot="title">
      Private Label Creatine <span class="text-accent dark:text-white">OEM</span>
    </Fragment>
    <Fragment slot="subtitle">
      Creatine monohydrate gummies, powder, and capsules for your brand — sampling, custom flavors, packaging, and
      compliance documentation support. B2B inquiry only.
    </Fragment>
  </Hero>

  <Features
    id="powder"
    tagline="Capabilities"
    title="Three formats for private label"
    subtitle="Starting configurations below — formula, pack-out, testing, and MOQ confirmed on quote. See full specs on Product programs."
    columns={3}
    items={[
      {
        title: 'Creatine gummies OEM',
        description:
          '~1,000 mg/gummy or ~5 g across 3 gummies; 60/90-count bottles; pectin-based / gelatin-free where supported; sugar-free options (polyols may apply); PET, doypack, sachet.',
        icon: 'tabler:candy',
      },
      {
        title: 'Creatine powder OEM',
        description:
          '300 g / 500 g / 1 kg tubs or pouches; 25 kg bulk drums; 80 mesh & 200-mesh micronized particle-size options for fill/dispersion; unflavored + flavor development.',
        icon: 'tabler:stack',
      },
      {
        title: 'Creatine capsules OEM',
        description:
          'Approx. 750–1,000 mg/capsule; bottles 60–240; gelatin, HPMC, or pullulan shells subject to program. Scoop-free convenience for travel-oriented lines.',
        icon: 'tabler:pill',
      },
      {
        title: 'Custom flavors & packaging',
        description: 'Match your brand system: flavor profiles, bottle/pouch/tub artwork, and carton marks.',
        icon: 'tabler:palette',
      },
      {
        title: 'Certificates narrative',
        description:
          'COA pathways, third-party testing options, and facility documentation discussed during quote — not medical claims.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'MOQ guidance',
        description:
          'Gummy standard-bottle programs often start around 1,000 units; powder trials often 500–1,000 units; capsules commonly from ~1,000 bottles — confirm on inquiry.',
        icon: 'tabler:package',
      },
    ]}
  />

  <Content id="gummies">
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight mb-2">Gummies — hero private-label format</h3>
      <p class="text-muted mb-3">
        Convenient, pre-portioned creatine monohydrate gummies for daily sports-nutrition routines. Approve taste, texture,
        and pack-out on samples, then scale to trial MOQ or ongoing monthly volume.
      </p>
      <ul class="mt-2 space-y-2 text-muted list-disc list-inside">
        <li>Dose: ~1,000 mg per gummy <strong>or</strong> ~5 g across a 3-gummy serving</li>
        <li>Packs: 60- or 90-count bottles (90 @ 3/day ≈ 30 servings); doypack &amp; sachet options</li>
        <li>Options: pectin-based / gelatin-free where formula supports; sugar-free (0 g sugar; polyols may apply)</li>
        <li>Quality: finished-product lot COA (creatine / creatinine where relevant), matrix assay, stability — not raw-material COA alone</li>
      </ul>
      <p class="mt-4">
        <a href="/products#gummies" class="underline text-primary font-medium">Full gummies program specs →</a>
      </p>
    </Fragment>
  </Content>

  <Content id="capsules" isAfterContent={true}>
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight mb-2">Capsules &amp; powder — supporting formats</h3>
      <p class="text-muted mb-3">
        Powder remains the volume workhorse (retail fills and bulk drums). Capsules add a scoop-free wing for convenience and
        travel channels. Multiple capsules may be needed for a 3–5 g serving depending on fill — final serving on the approved
        label.
      </p>
      <ul class="mt-2 space-y-2 text-muted list-disc list-inside">
        <li>Powder: 300 g / 500 g / 1 kg · 25 kg drums · mesh options for process fit (not absorption claims)</li>
        <li>Capsules: ~750–1,000 mg · 60–240 counts · gelatin / HPMC / pullulan</li>
        <li>Sample kit → formula lock → label / artwork → production after deposit &amp; sign-off</li>
      </ul>
      <p class="mt-4">
        <a href="/products" class="underline text-primary font-medium">All product programs →</a>
      </p>
      <p class="mt-6 text-sm text-muted border-l-4 border-slate-300 pl-4">
        <strong>Dietary supplement notice:</strong> Products are intended as dietary supplements under DSHEA. Statements
        have not been evaluated by the FDA. Not intended to diagnose, treat, cure, or prevent any disease.
      </p>
    </Fragment>
  </Content>

  <Steps
    title="OEM project path"
    items={[
      { title: 'Brief', description: 'Format, flavor, packaging, volume, destination.', icon: 'tabler:file-invoice' },
      { title: 'Sample', description: 'Evaluate gummies, powder, or capsules before bulk.', icon: 'tabler:flask' },
      { title: 'Quote & MOQ', description: 'Tiered pricing for trial and ongoing runs.', icon: 'tabler:tag' },
      { title: 'Produce & ship', description: 'QC, pack, and export for your market.', icon: 'tabler:truck-delivery' },
    ]}
  />

  <FAQs title="OEM FAQ" items={faqItems} />

  <CallToAction
    title="Request an OEM / private label quote"
    subtitle="Channel defaults to OEM on the contact form — add format, volume, and packaging notes."
    actions={[
      { variant: 'primary', text: 'OEM inquiry', href: quoteHref },
      { text: 'Product programs', href: '/products' },
    ]}
  />

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      '@id': `${siteUrl}${pagePath}#webpage`,
      url: `${siteUrl}${pagePath}`,
      name: metadata.title,
      description: metadata.description,
      isPartOf: { '@type': 'WebSite', url: `${siteUrl}/` },
      publisher: { '@id': ORGANIZATION_ID },
    })}
  />
</Layout>
