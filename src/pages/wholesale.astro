---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Steps from '~/components/widgets/Steps.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getSiteUrl } from '~/utils/site-url';
import { ORGANIZATION_ID } from '~/utils/organization-schema';
import { BREADCRUMB_HOME, BREADCRUMB_WHOLESALE, buildBreadcrumbList } from '~/utils/breadcrumb-schema';

const siteUrl = getSiteUrl();
const pagePath = '/wholesale';
const quoteHref = '/contact?looking=Wholesale%20pricing#inquiry-form';

const metadata = {
  title: 'Wholesale Creatine | Carton Specs & Price List',
  description:
    'Wholesale creatine monohydrate powder, gummies, and capsules — carton SKU examples, MOQ tiers, distributor and gym accounts. Specs confirmed on price list. Request wholesale pricing.',
  ignoreTitleTemplate: true,
};

const faqItems = [
  {
    title: 'Who is wholesale for?',
    description:
      'Distributors, gyms/retailers, and online sellers who need <strong>standard carton SKUs</strong> rather than full custom OEM programs.',
  },
  {
    title: 'How do I get pricing?',
    description:
      'Submit the <a href="/contact?looking=Wholesale%20pricing#inquiry-form" class="underline text-primary">wholesale inquiry</a> with expected volume and ship-to country. We share carton MOQs and price-list guidance. Specs below are examples — confirmed on the price list.',
  },
  {
    title: 'Can wholesale buyers also request samples?',
    description: 'Yes. Select <strong>Sample</strong> or note sample needs on the form before first carton order.',
  },
];

const breadcrumbSchema = buildBreadcrumbList([
  { name: BREADCRUMB_HOME.en, path: '/' },
  { name: BREADCRUMB_WHOLESALE.en, path: pagePath },
]);
---

<Layout metadata={metadata}>
  <Hero
    tagline="Wholesale"
    actions={[
      { variant: 'primary', text: 'Request price list', href: quoteHref, icon: 'tabler:file-invoice' },
      { text: 'Product programs', href: '/products' },
      { text: 'OEM / private label', href: '/oem' },
    ]}
  >
    <Fragment slot="title">
      Wholesale Creatine <span class="text-accent dark:text-white">Cartons</span>
    </Fragment>
    <Fragment slot="subtitle">
      Standard creatine powder, gummy, and capsule SKUs for distributors, gyms, and online sellers — carton specs, MOQ
      tiers, and account onboarding via inquiry.
    </Fragment>
  </Hero>

  <Features
    tagline="Wholesale offer"
    title="What wholesale partners receive"
    columns={2}
    items={[
      { title: 'Carton specs', description: 'Clear units-per-carton and pack-out notes for powder and gummy SKUs (confirmed on quote).', icon: 'tabler:box' },
      { title: 'MOQ tiers', description: 'Trial carton MOQs and better tiers for pallet / ongoing monthly volume.', icon: 'tabler:chart-arrows-vertical' },
      { title: 'Account application', description: 'Tell us buyer type and channel — we guide documents and first-order terms.', icon: 'tabler:user' },
      { title: 'Reorder pathway', description: 'Stable SKUs for repeat monthly purchases after the first approved shipment.', icon: 'tabler:check' },
    ]}
  />

  <Content>
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight mb-3 dark:text-white">Standard carton SKU examples</h2>
      <p class="text-muted mb-4">
        Illustrative pack-outs for planning. <strong>Units per carton, net weight, and MOQ are confirmed on the price list</strong>
        for your destination and account tier.
      </p>
      <div class="overflow-x-auto">
        <table class="w-full text-sm text-left border-collapse">
          <thead>
            <tr class="border-b border-slate-200 dark:border-slate-700">
              <th class="py-2 pr-3 font-semibold dark:text-white">SKU family</th>
              <th class="py-2 pr-3 font-semibold dark:text-white">Unit example</th>
              <th class="py-2 font-semibold dark:text-white">Notes</th>
            </tr>
          </thead>
          <tbody class="text-muted dark:text-slate-400">
            <tr class="border-b border-slate-100 dark:border-slate-800">
              <td class="py-2 pr-3 font-medium dark:text-slate-200">Creatine gummies</td>
              <td class="py-2 pr-3">60-count or 90-count PET bottle</td>
              <td class="py-2">Carton pack-out &amp; MOQ on price list</td>
            </tr>
            <tr class="border-b border-slate-100 dark:border-slate-800">
              <td class="py-2 pr-3 font-medium dark:text-slate-200">Creatine powder</td>
              <td class="py-2 pr-3">300 g / 500 g / 1 kg tub or pouch</td>
              <td class="py-2">Retail fills; bulk drum programs available</td>
            </tr>
            <tr class="border-b border-slate-100 dark:border-slate-800">
              <td class="py-2 pr-3 font-medium dark:text-slate-200">Creatine capsules</td>
              <td class="py-2 pr-3">60–240 count bottles</td>
              <td class="py-2">Where offered as standard wholesale SKU</td>
            </tr>
            <tr>
              <td class="py-2 pr-3 font-medium dark:text-slate-200">Bulk powder</td>
              <td class="py-2 pr-3">25 kg drum</td>
              <td class="py-2">Ingredient / production programs</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-sm text-muted">
        Need custom flavors or branded packaging instead?
        <a href="/oem" class="underline text-primary">See OEM / private label</a>
        or <a href="/products" class="underline text-primary">product programs</a>.
      </p>
    </Fragment>
  </Content>

  <Steps
    title="Open a wholesale account"
    items={[
      { title: 'Apply', description: 'Submit buyer type, volume, and destination.', icon: 'tabler:file-invoice' },
      { title: 'Price list', description: 'Receive carton MOQs and pricing guidance.', icon: 'tabler:tag' },
      { title: 'Sample (optional)', description: 'Validate SKU before first carton buy.', icon: 'tabler:flask' },
      { title: 'Order & reorder', description: 'Ship cartons and set a reorder cadence.', icon: 'tabler:truck-delivery' },
    ]}
  />

  <FAQs title="Wholesale FAQ" items={faqItems} />

  <CallToAction
    title="Get wholesale pricing"
    subtitle="We’ll reply with carton MOQs and next steps for your channel. Specs confirmed on price list."
    actions={[{ variant: 'primary', text: 'Wholesale inquiry', href: quoteHref }]}
  />

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: metadata.title,
      description: metadata.description,
      url: `${siteUrl}${pagePath}`,
      publisher: { '@id': ORGANIZATION_ID },
    })}
  />
</Layout>
