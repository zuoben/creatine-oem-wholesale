---
import type { GetStaticPaths } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import { getAboutCopy } from '~/i18n/copy-pages';
import { I18N_LOCALES, localizePath, LOCALE_META, type Locale } from '~/i18n/locales';

export const getStaticPaths = (() => I18N_LOCALES.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
const c = getAboutCopy(lang);
const L = (path: string) => localizePath(path, lang);

const metadata = {
  title: c.title,
  description: c.description,
  robots: { index: false, follow: true },
  ignoreTitleTemplate: true,
  openGraph: { locale: LOCALE_META[lang].ogLocale },
};
---

<Layout metadata={metadata}>
  <section class="py-16 text-center">
    <p class="text-muted mb-4">{c.body}</p>
    <p><a class="btn btn-primary" href={L('/quality')}>{c.cta}</a></p>
  </section>
  <meta http-equiv="refresh" content={`0;url=${L('/quality')}`} />
</Layout>
