---
import type { GetStaticPaths } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getQualityCopy } from '~/i18n/copy-pages';
import { I18N_LOCALES, localizePath, LOCALE_META, type Locale } from '~/i18n/locales';
import { getSiteUrl } from '~/utils/site-url';
import { buildAboutPageSchema, buildManufacturingPlantSchema, ORGANIZATION_ID } from '~/utils/organization-schema';
import { buildBreadcrumbList } from '~/utils/breadcrumb-schema';

export const getStaticPaths = (() => I18N_LOCALES.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
const c = getQualityCopy(lang);
const siteUrl = getSiteUrl();
const L = (path: string) => localizePath(path, lang);
const pagePath = L('/quality');

const metadata = {
  title: c.title,
  description: c.description,
  ignoreTitleTemplate: true,
  openGraph: { locale: LOCALE_META[lang].ogLocale },
};

const breadcrumbSchema = buildBreadcrumbList([
  { name: 'Home', path: L('/') },
  { name: c.breadcrumb, path: pagePath },
]);
---

<Layout metadata={metadata}>
  <Hero
    tagline={c.tagline}
    actions={[
      { variant: 'primary', text: c.ctaDocs, href: `${L('/contact')}#inquiry-form` },
      { text: c.ctaOem, href: L('/oem') },
    ]}
  >
    <Fragment slot="title">
      {c.hero1} <span class="text-accent dark:text-white">{c.hero2}</span>
    </Fragment>
    <Fragment slot="subtitle">{c.heroSub}</Fragment>
  </Hero>

  <Features title={c.featTitle} columns={2} items={c.featItems} />

  <Content>
    <Fragment slot="content">
      <h2 class="text-2xl font-bold mb-3">{c.gummyH}</h2>
      <p class="text-muted mb-3">{c.gummyP1}</p>
      <p class="text-muted">
        {c.gummyP2}{' '}
        <a href={`${L('/products')}#gummies`} class="underline text-primary">{c.gummyLink}</a>.
      </p>
    </Fragment>
  </Content>

  <Content>
    <Fragment slot="content">
      <h2 class="text-2xl font-bold mb-3">{c.dsheaH}</h2>
      <p class="text-muted mb-3">{c.dsheaP1}</p>
      <p class="text-muted mb-3">{c.dsheaP2}</p>
      <p class="text-sm text-muted border-l-4 border-slate-300 pl-4">{c.note}</p>
    </Fragment>
  </Content>

  <CallToAction
    title={c.ctaTitle}
    actions={[{ variant: 'primary', text: c.ctaContact, href: `${L('/contact')}#inquiry-form` }]}
  />

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(buildAboutPageSchema())} />
  <script type="application/ld+json" set:html={JSON.stringify(buildManufacturingPlantSchema())} />
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: metadata.title,
      url: `${siteUrl}${pagePath}`,
      inLanguage: LOCALE_META[lang].htmlLang,
      publisher: { '@id': ORGANIZATION_ID },
    })}
  />
</Layout>
