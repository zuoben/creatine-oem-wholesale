---
import type { GetStaticPaths } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getHomeCopy } from '~/i18n/copy-home';
import { I18N_LOCALES, localizePath, LOCALE_META, type Locale } from '~/i18n/locales';
import { getSiteUrl } from '~/utils/site-url';
import {
  buildOrganizationSchema,
  buildManufacturingPlantSchema,
  ORGANIZATION_ID,
} from '~/utils/organization-schema';

export const getStaticPaths = (() => I18N_LOCALES.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
const c = getHomeCopy(lang);
const siteUrl = getSiteUrl();
const L = (path: string) => localizePath(path, lang);

const metadata = {
  title: c.title,
  description: c.description,
  ignoreTitleTemplate: true,
  openGraph: { locale: LOCALE_META[lang].ogLocale },
};

const faqItems = c.faqs;
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Crest Creatine',
  url: `${siteUrl}${L('/')}`,
  description: c.description,
  inLanguage: LOCALE_META[lang].htmlLang,
  publisher: { '@id': ORGANIZATION_ID },
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(({ title, description }) => ({
    '@type': 'Question',
    name: title,
    acceptedAnswer: { '@type': 'Answer', text: description.replace(/<[^>]+>/g, '') },
  })),
};
---

<Layout metadata={metadata}>
  <Hero
    tagline={c.tagline}
    actions={[
      { variant: 'primary', text: c.ctaOem, href: L('/oem'), icon: 'tabler:building-factory-2' },
      { text: c.ctaWholesale, href: L('/wholesale'), icon: 'tabler:building-store' },
    ]}
  >
    <Fragment slot="title">
      {c.hero1} <span class="text-accent dark:text-white">{c.hero2}</span>
    </Fragment>
    <Fragment slot="subtitle">{c.heroSub}</Fragment>
  </Hero>

  <Features id="trust" tagline={c.trustTag} title={c.trustTitle} subtitle={c.trustSub} columns={2} items={c.trustItems} />

  <Features2
    tagline={c.buyTag}
    title={c.buyTitle}
    columns={2}
    items={[
      { title: c.buyOemTitle, description: c.buyOemDesc, icon: 'tabler:palette' },
      { title: c.buyWhTitle, description: c.buyWhDesc, icon: 'tabler:truck-delivery' },
    ]}
  />

  <Features2
    id="product-programs"
    tagline={c.prodTag}
    title={c.prodTitle}
    subtitle={c.prodSub}
    columns={3}
    items={[
      { title: c.gummiesTitle, description: c.gummiesDesc, icon: 'tabler:candy', callToAction: { text: c.gummiesCta, href: `${L('/products')}#gummies` } },
      { title: c.powderTitle, description: c.powderDesc, icon: 'tabler:stack', callToAction: { text: c.powderCta, href: `${L('/products')}#powder` } },
      { title: c.capsTitle, description: c.capsDesc, icon: 'tabler:pill', callToAction: { text: c.capsCta, href: `${L('/products')}#capsules` } },
    ]}
  />

  <Steps title={c.stepsTitle} items={c.steps} />
  <FAQs id="faq" title={c.faqTitle} items={faqItems} />

  <CallToAction
    title={c.ctaTitle}
    subtitle={c.ctaSub}
    actions={[
      { variant: 'primary', text: c.ctaForm, href: `${L('/contact')}#inquiry-form` },
      { text: c.ctaProducts, href: L('/products') },
      { text: c.ctaOemDetails, href: L('/oem') },
      { text: c.ctaWhDetails, href: L('/wholesale') },
    ]}
  />

  <script type="application/ld+json" set:html={JSON.stringify(buildOrganizationSchema())} />
  <script type="application/ld+json" set:html={JSON.stringify(buildManufacturingPlantSchema())} />
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Layout>
