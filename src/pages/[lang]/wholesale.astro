---
import type { GetStaticPaths } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Steps from '~/components/widgets/Steps.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getWholesaleCopy } from '~/i18n/copy-pages';
import { I18N_LOCALES, localizePath, LOCALE_META, type Locale } from '~/i18n/locales';
import { getSiteUrl } from '~/utils/site-url';
import { ORGANIZATION_ID } from '~/utils/organization-schema';
import { buildBreadcrumbList } from '~/utils/breadcrumb-schema';

export const getStaticPaths = (() => I18N_LOCALES.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
const c = getWholesaleCopy(lang);
const siteUrl = getSiteUrl();
const L = (path: string) => localizePath(path, lang);
const pagePath = L('/wholesale');
const quoteHref = `${L('/contact')}?looking=Wholesale%20pricing#inquiry-form`;

const metadata = {
  title: c.title,
  description: c.description,
  ignoreTitleTemplate: true,
  openGraph: { locale: LOCALE_META[lang].ogLocale },
};

const breadcrumbSchema = buildBreadcrumbList([
  { name: 'Home', path: L('/') },
  { name: c.breadcrumb, path: pagePath },
]);
---

<Layout metadata={metadata}>
  <Hero
    tagline={c.tagline}
    actions={[
      { variant: 'primary', text: c.ctaPrice, href: quoteHref, icon: 'tabler:file-invoice' },
      { text: c.ctaProducts, href: L('/products') },
      { text: c.ctaOem, href: L('/oem') },
    ]}
  >
    <Fragment slot="title">
      {c.hero1} <span class="text-accent dark:text-white">{c.hero2}</span>
    </Fragment>
    <Fragment slot="subtitle">{c.heroSub}</Fragment>
  </Hero>

  <Features tagline={c.offerTag} title={c.offerTitle} columns={2} items={c.offerItems} />

  <Content>
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight mb-3 dark:text-white">{c.skuTitle}</h2>
      <p class="text-muted mb-4">{c.skuIntro}</p>
      <div class="overflow-x-auto">
        <table class="w-full text-sm text-left border-collapse">
          <thead>
            <tr class="border-b border-slate-200 dark:border-slate-700">
              <th class="py-2 pr-3 font-semibold dark:text-white">{c.thSku}</th>
              <th class="py-2 pr-3 font-semibold dark:text-white">{c.thUnit}</th>
              <th class="py-2 font-semibold dark:text-white">{c.thNotes}</th>
            </tr>
          </thead>
          <tbody class="text-muted dark:text-slate-400">
            {c.rows.map((row, i) => (
              <tr class:list={[i < c.rows.length - 1 && 'border-b border-slate-100 dark:border-slate-800']}>
                <td class="py-2 pr-3 font-medium dark:text-slate-200">{row.sku}</td>
                <td class="py-2 pr-3">{row.unit}</td>
                <td class="py-2">{row.notes}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-sm text-muted">
        {c.skuFoot}{' '}
        <a href={L('/oem')} class="underline text-primary">{c.skuOemLink}</a>
        {' '}
        <a href={L('/products')} class="underline text-primary">{c.skuProdLink}</a>.
      </p>
    </Fragment>
  </Content>

  <Steps title={c.stepsTitle} items={c.steps} />
  <FAQs title={c.faqTitle} items={c.faqs} />

  <CallToAction
    title={c.ctaTitle}
    subtitle={c.ctaSub}
    actions={[{ variant: 'primary', text: c.ctaInquiry, href: quoteHref }]}
  />

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: metadata.title,
      description: metadata.description,
      url: `${siteUrl}${pagePath}`,
      inLanguage: LOCALE_META[lang].htmlLang,
      publisher: { '@id': ORGANIZATION_ID },
    })}
  />
</Layout>
