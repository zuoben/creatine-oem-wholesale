---
import type { GetStaticPaths } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Steps from '~/components/widgets/Steps.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getOemCopy } from '~/i18n/copy-pages';
import { I18N_LOCALES, localizePath, LOCALE_META, type Locale } from '~/i18n/locales';
import { getSiteUrl } from '~/utils/site-url';
import { ORGANIZATION_ID } from '~/utils/organization-schema';
import { buildBreadcrumbList } from '~/utils/breadcrumb-schema';

export const getStaticPaths = (() => I18N_LOCALES.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
const c = getOemCopy(lang);
const siteUrl = getSiteUrl();
const L = (path: string) => localizePath(path, lang);
const pagePath = L('/oem');
const quoteHref = `${L('/contact')}?looking=OEM%2FPrivate%20label#inquiry-form`;

const metadata = {
  title: c.title,
  description: c.description,
  ignoreTitleTemplate: true,
  openGraph: { locale: LOCALE_META[lang].ogLocale },
};

const faqItems = c.faqs;
const breadcrumbSchema = buildBreadcrumbList([
  { name: 'Home', path: L('/') },
  { name: c.breadcrumb, path: pagePath },
]);
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(({ title, description }) => ({
    '@type': 'Question',
    name: title,
    acceptedAnswer: { '@type': 'Answer', text: description.replace(/<[^>]+>/g, '') },
  })),
};
---

<Layout metadata={metadata}>
  <Hero
    tagline={c.tagline}
    actions={[
      { variant: 'primary', text: c.ctaStart, href: quoteHref, icon: 'tabler:send' },
      { text: c.ctaProducts, href: L('/products') },
      { text: c.ctaWholesale, href: L('/wholesale') },
    ]}
  >
    <Fragment slot="title">
      {c.hero1} <span class="text-accent dark:text-white">{c.hero2}</span>
    </Fragment>
    <Fragment slot="subtitle">{c.heroSub}</Fragment>
  </Hero>

  <Features id="powder" tagline={c.capTag} title={c.capTitle} subtitle={c.capSub} columns={3} items={c.items} />

  <Content id="gummies">
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight mb-2">{c.gummiesH}</h3>
      <p class="text-muted mb-3">{c.gummiesP}</p>
      <ul class="mt-2 space-y-2 text-muted list-disc list-inside">
        {c.gummiesBullets.map((b) => <li set:html={b} />)}
      </ul>
      <p class="mt-4">
        <a href={`${L('/products')}#gummies`} class="underline text-primary font-medium">{c.gummiesLink}</a>
      </p>
    </Fragment>
  </Content>

  <Content id="capsules" isAfterContent={true}>
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight mb-2">{c.capsH}</h3>
      <p class="text-muted mb-3">{c.capsP}</p>
      <ul class="mt-2 space-y-2 text-muted list-disc list-inside">
        {c.capsBullets.map((b) => <li set:html={b} />)}
      </ul>
      <p class="mt-4">
        <a href={L('/products')} class="underline text-primary font-medium">{c.productsLink}</a>
      </p>
      <p class="mt-6 text-sm text-muted border-l-4 border-slate-300 pl-4">
        <strong>{c.dshea}</strong>
      </p>
    </Fragment>
  </Content>

  <Steps title={c.stepsTitle} items={c.steps} />
  <FAQs title={c.faqTitle} items={faqItems} />

  <CallToAction
    title={c.ctaTitle}
    subtitle={c.ctaSub}
    actions={[
      { variant: 'primary', text: c.ctaInquiry, href: quoteHref },
      { text: c.ctaProducts, href: L('/products') },
    ]}
  />

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      '@id': `${siteUrl}${pagePath}#webpage`,
      url: `${siteUrl}${pagePath}`,
      name: metadata.title,
      description: metadata.description,
      inLanguage: LOCALE_META[lang].htmlLang,
      isPartOf: { '@type': 'WebSite', url: `${siteUrl}/` },
      publisher: { '@id': ORGANIZATION_ID },
    })}
  />
</Layout>
