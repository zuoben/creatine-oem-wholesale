---
import type { GetStaticPaths } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features2 from '~/components/widgets/Features2.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import { getContactCopy } from '~/i18n/copy-pages';
import { getInquiryForm } from '~/i18n/forms';
import { I18N_LOCALES, localizePath, LOCALE_META, WHATSAPP_BY_LOCALE, type Locale } from '~/i18n/locales';
import { getWhatsAppUrl } from '~/utils/whatsapp';
import { buildContactPageSchema } from '~/utils/organization-schema';

export const getStaticPaths = (() => I18N_LOCALES.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
const c = getContactCopy(lang);
const inquiry = getInquiryForm(lang);
const whatsappUrl = getWhatsAppUrl(WHATSAPP_BY_LOCALE[lang]);
const L = (path: string) => localizePath(path, lang);

const metadata = {
  title: c.title,
  description: c.description,
  ignoreTitleTemplate: true,
  openGraph: { locale: LOCALE_META[lang].ogLocale },
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      { variant: 'primary', text: c.ctaForm, href: '#inquiry-form', icon: 'tabler:send' },
      { text: c.ctaWa, href: whatsappUrl, target: '_blank' },
    ]}
  >
    <Fragment slot="title">{c.hero1} <span class="text-accent dark:text-white">{c.hero2}</span></Fragment>
    <Fragment slot="subtitle">{c.heroSub}</Fragment>
  </Hero>

  <ContactUs
    id="inquiry-form"
    title={c.formTitle}
    subtitle={c.formSub}
    compact
    inputs={inquiry.inputs}
    textarea={inquiry.textarea}
    disclaimer={inquiry.disclaimer}
    button={inquiry.button}
    description={inquiry.description}
  />

  <script is:inline>
    (function () {
      try {
        var params = new URLSearchParams(window.location.search);
        var looking = params.get('looking') || params.get('channel');
        if (!looking) return;
        var sel = document.querySelector('#inquiry-form select[name="channel"], form[data-inquiry-form] select[name="channel"]');
        if (sel) {
          var opts = Array.prototype.slice.call(sel.options);
          var match = opts.find(function (o) { return o.value === looking || o.value.toLowerCase() === looking.toLowerCase(); });
          if (match) sel.value = match.value;
        }
      } catch (e) {}
    })();
  </script>

  <Features2 tagline={c.chanTag} title={c.chanTitle} columns={3} items={c.chanItems} />
  <FAQs title={c.faqTitle} items={c.faqs} />

  <CallToAction
    title={c.ctaTitle}
    subtitle={c.ctaSub}
    actions={[
      { variant: 'primary', text: c.ctaOpenWa, href: whatsappUrl, target: '_blank' },
      { text: c.ctaHome, href: L('/') },
    ]}
  />

  <script type="application/ld+json" set:html={JSON.stringify(buildContactPageSchema())} />
</Layout>
