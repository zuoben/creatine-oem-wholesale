---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getProductsCopy } from '~/i18n/copy-products';
import { localizePath, LOCALE_META } from '~/i18n/locales';
import { getSiteUrl } from '~/utils/site-url';
import { ORGANIZATION_ID } from '~/utils/organization-schema';
import { buildBreadcrumbList } from '~/utils/breadcrumb-schema';

const lang = 'en' as const;
const c = getProductsCopy(lang);
const siteUrl = getSiteUrl();
const L = (path: string) => localizePath(path, lang);
const pagePath = L('/products');

const oemGummies = `${L('/contact')}?looking=OEM%2FPrivate%20label%20-%20Creatine%20gummies#inquiry-form`;
const oemPowder = `${L('/contact')}?looking=OEM%2FPrivate%20label%20-%20Creatine%20powder#inquiry-form`;
const oemCapsules = `${L('/contact')}?looking=OEM%2FPrivate%20label%20-%20Creatine%20capsules#inquiry-form`;
const wholesaleHref = `${L('/contact')}?looking=Wholesale%20pricing#inquiry-form`;

const metadata = {
  title: c.title,
  description: c.description,
  ignoreTitleTemplate: true,
  openGraph: { locale: LOCALE_META[lang].ogLocale },
};

const breadcrumbSchema = buildBreadcrumbList([
  { name: 'Home', path: L('/') },
  { name: c.breadcrumb, path: pagePath },
]);

const productPrograms = [
  {
    name: c.gummiesTitle,
    description: c.gummiesIntro,
    url: `${siteUrl}${pagePath}#gummies`,
    image: `${siteUrl}/images/products/creatine-gummies.svg`,
    category: 'Creatine gummies OEM',
    moq: 'Trial/program MOQs commonly start around 1,000 units for standard bottle programs.',
  },
  {
    name: c.powderTitle,
    description: c.powderIntro,
    url: `${siteUrl}${pagePath}#powder`,
    image: `${siteUrl}/images/products/creatine-powder.svg`,
    category: 'Creatine monohydrate powder OEM',
    moq: 'Trial private-label powder often in the 500–1,000 unit range.',
  },
  {
    name: c.capsTitle,
    description: c.capsIntro,
    url: `${siteUrl}${pagePath}#capsules`,
    image: `${siteUrl}/images/products/creatine-capsules.svg`,
    category: 'Creatine capsules OEM',
    moq: 'Capsule programs commonly start around 1,000 bottles.',
  },
];

const productListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Crest Creatine OEM product programs',
  itemListElement: productPrograms.map((product, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Product',
      name: product.name,
      description: product.description,
      image: product.image,
      url: product.url,
      brand: { '@type': 'Brand', name: 'Crest Creatine' },
      category: product.category,
      offers: {
        '@type': 'Offer',
        url: product.url,
        availability: 'https://schema.org/InStock',
        description: product.moq,
      },
    },
  })),
};
---

<Layout metadata={metadata}>
  <Hero
    tagline={c.tagline}
    actions={[
      { variant: 'primary', text: c.ctaOem, href: `${L('/contact')}?looking=OEM%2FPrivate%20label#inquiry-form`, icon: 'tabler:send' },
      { text: c.ctaWholesale, href: wholesaleHref },
    ]}
  >
    <Fragment slot="title">
      {c.hero1} <span class="text-accent dark:text-white">{c.hero2}</span>
    </Fragment>
    <Fragment slot="subtitle">{c.heroSub}</Fragment>
  </Hero>

  <Content id="gummies" isReversed={false} callToAction={{ text: c.gummiesCta, href: oemGummies }} items={c.gummiesItems}>
    <Fragment slot="content">
      <p class="text-sm font-semibold uppercase tracking-wide text-primary mb-2">{c.gummiesKicker}</p>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-3 dark:text-white">{c.gummiesTitle}</h2>
      <p class="text-muted dark:text-slate-400 mb-4">{c.gummiesIntro}</p>
      <p class="text-sm text-muted dark:text-slate-400 border-l-4 border-teal-400/60 pl-4">
        <strong>{c.qualityNote}</strong>{' '}
        <a href={L('/quality')} class="underline text-primary">{c.qualityLink}</a>.
      </p>
    </Fragment>
    <Fragment slot="image">
      <img src="/images/products/creatine-gummies.svg" alt={c.altGummies} width="640" height="640" class="w-full h-auto bg-sky-50 dark:bg-slate-800" loading="lazy" decoding="async" />
    </Fragment>
  </Content>

  <Content id="powder" isReversed={true} isAfterContent={true} callToAction={{ text: c.powderCta, href: oemPowder }} items={c.powderItems}>
    <Fragment slot="content">
      <p class="text-sm font-semibold uppercase tracking-wide text-primary mb-2">{c.powderKicker}</p>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-3 dark:text-white">{c.powderTitle}</h2>
      <p class="text-muted dark:text-slate-400 mb-4">{c.powderIntro}</p>
    </Fragment>
    <Fragment slot="image">
      <img src="/images/products/creatine-powder.svg" alt={c.altPowder} width="640" height="640" class="w-full h-auto bg-cyan-50 dark:bg-slate-800" loading="lazy" decoding="async" />
    </Fragment>
  </Content>

  <Content id="capsules" isReversed={false} isAfterContent={true} callToAction={{ text: c.capsCta, href: oemCapsules }} items={c.capsItems}>
    <Fragment slot="content">
      <p class="text-sm font-semibold uppercase tracking-wide text-primary mb-2">{c.capsKicker}</p>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-3 dark:text-white">{c.capsTitle}</h2>
      <p class="text-muted dark:text-slate-400 mb-4">{c.capsIntro}</p>
    </Fragment>
    <Fragment slot="image">
      <img src="/images/products/creatine-capsules.svg" alt={c.altCaps} width="640" height="640" class="w-full h-auto bg-teal-50 dark:bg-slate-800" loading="lazy" decoding="async" />
    </Fragment>
  </Content>

  <Features tagline={c.nextTag} title={c.nextTitle} columns={3} items={c.nextItems} />

  <section class="max-w-3xl mx-auto px-4 md:px-8 pb-8">
    <p class="text-sm text-muted dark:text-slate-400 border-l-4 border-slate-300 dark:border-slate-600 pl-4">
      <strong>{c.dshea}</strong>
    </p>
  </section>

  <CallToAction
    title={c.ctaTitle}
    subtitle={c.ctaSub}
    actions={[
      { variant: 'primary', text: c.ctaOemInq, href: `${L('/contact')}?looking=OEM%2FPrivate%20label#inquiry-form` },
      { text: c.ctaWhInq, href: wholesaleHref },
      { text: c.ctaOemOver, href: L('/oem') },
    ]}
  />

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(productListSchema)} />
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      '@id': `${siteUrl}${pagePath}#webpage`,
      url: `${siteUrl}${pagePath}`,
      name: metadata.title,
      description: metadata.description,
      inLanguage: LOCALE_META[lang].htmlLang,
      isPartOf: { '@type': 'WebSite', url: `${siteUrl}/` },
      publisher: { '@id': ORGANIZATION_ID },
    })}
  />
</Layout>
