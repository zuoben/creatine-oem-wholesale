---
import Layout from '~/layouts/PageLayout.astro';
import { getTermsCopy } from '~/i18n/copy-pages';
import { localizePath, LOCALE_META } from '~/i18n/locales';

const lang = 'en' as const;
const c = getTermsCopy(lang);
const L = (path: string) => localizePath(path, lang);

const metadata = {
  title: c.title,
  description: c.description,
  ignoreTitleTemplate: true,
  openGraph: { locale: LOCALE_META[lang].ogLocale },
};
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-3xl px-4 py-12 md:px-8 prose prose-slate dark:prose-invert">
    <h1>{c.title}</h1>
    <p class="text-sm text-muted"><em>{c.updated}</em></p>
    <div set:html={c.bodyHtml} />
    <p><a class="underline text-primary" href={L('/contact')}>Contact</a></p>
  </section>
</Layout>
