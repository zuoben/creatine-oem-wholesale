---
import { Icon } from 'astro-icon/components';
import Form from '~/components/ui/Form.astro';
import { getWhatsAppUrl } from '~/utils/whatsapp';
import { getInquiryForm } from '~/i18n/forms';
import { getContactCopy } from '~/i18n/copy-pages';
import { getLocaleFromPath } from '~/i18n/locales';
import type { Disclaimer, Input, Textarea } from '~/types';

export interface Props {
  contactBtn: boolean;
  whatsappUrl?: string;
  title?: string;
  subtitle?: string;
  button?: string;
  description?: string;
  inputs?: Input[];
  textarea?: Textarea;
  disclaimer?: Disclaimer;
  closeLabel?: string;
  preferChat?: string;
  waLabel?: string;
}

const locale = getLocaleFromPath(Astro.url.pathname);
const inquiry = getInquiryForm(locale);
const contactCopy = getContactCopy(locale);

const {
  contactBtn,
  whatsappUrl: whatsappUrlProp,
  title = contactCopy.formTitle,
  subtitle = contactCopy.formSub,
  button = inquiry.button,
  description = inquiry.description,
  inputs = inquiry.inputs,
  textarea = inquiry.textarea,
  disclaimer = inquiry.disclaimer,
  closeLabel = inquiry.close,
  preferChat = inquiry.preferChat,
  waLabel = contactCopy.wa,
} = Astro.props;

const whatsappUrl = whatsappUrlProp || getWhatsAppUrl();

/** Shared FAB chrome. Public site recolors via html.theme-mahjong [data-fab]. */
const fabBase =
  'fixed right-5 sm:right-6 z-50 flex h-12 w-12 sm:h-14 sm:w-14 items-center justify-center rounded-full shadow-lg ring-1 ring-black/5 transition-all duration-300 hover:scale-105 hover:shadow-xl dark:ring-white/10';
const fabIcon = 'w-6 h-6 sm:w-7 sm:h-7 text-white';
---

<!-- WhatsApp — same chrome as the other FABs; color comes from theme CSS -->
<a
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  data-aw-close-menu-on-mobile
  data-fab="whatsapp"
  class:list={[fabBase, 'bottom-16 bg-primary hover:bg-secondary']}
  aria-label="Chat on WhatsApp about American Mah Jongg wholesale"
>
  <Icon name="tabler:brand-whatsapp" class={fabIcon} aria-hidden="true" />
  <span class="sr-only">Chat on WhatsApp about American Mah Jongg wholesale</span>
</a>

<!-- Contact: quote modal (teal primary — designer theme) -->
{
  contactBtn ? (
    <button
      type="button"
      id="fab-contact-open"
      data-aw-close-menu-on-mobile
      class:list={[fabBase, 'bottom-34 cursor-pointer bg-primary hover:bg-secondary']}
      data-fab="contact"
      aria-label="Contact Hi Mah Jongg"
      aria-haspopup="dialog"
      aria-controls="fab-contact-modal"
    >
      <Icon name="tabler:mail" class={fabIcon} aria-hidden="true" />
      <span class="sr-only">Contact Hi Mah Jongg</span>
    </button>
  ) : (
    <a
      href="#contact"
      data-aw-close-menu-on-mobile
      class:list={[fabBase, 'bottom-34 bg-primary hover:bg-secondary']}
      data-fab="contact"
      aria-label="Contact Hi Mah Jongg"
    >
      <Icon name="tabler:mail" class={fabIcon} aria-hidden="true" />
      <span class="sr-only">Contact Hi Mah Jongg</span>
    </a>
  )
}

<!-- Back to top -->
<button
  id="back-to-top"
  type="button"
  data-aw-close-menu-on-mobile
  class:list={[fabBase, 'bottom-52 bg-primary hover:bg-secondary opacity-0 invisible']}
  data-fab="top"
  aria-label="Back to top"
>
  <Icon name="tabler:arrow-up" class={fabIcon} aria-hidden="true" />
</button>

{
  contactBtn && (
    <div
      id="fab-contact-modal"
      class="fixed inset-0 z-[80] hidden"
      role="dialog"
      aria-modal="true"
      aria-labelledby="fab-contact-title"
    >
      <div
        class="fab-contact-backdrop absolute inset-0 bg-black/50 backdrop-blur-[2px]"
        data-fab-contact-close
        aria-hidden="true"
      />
      <div class="relative flex min-h-full items-end sm:items-center justify-center p-0 sm:p-4 pointer-events-none">
        <div class="pointer-events-auto flex w-full min-w-0 sm:max-w-md max-h-[min(90vh,720px)] flex-col overflow-hidden rounded-t-2xl sm:rounded-2xl bg-white dark:bg-slate-900 shadow-2xl border border-gray-200 dark:border-slate-700">
          <div class="shrink-0 flex items-start justify-between gap-2 border-b border-gray-100 dark:border-slate-800 bg-white dark:bg-slate-900 px-4 sm:px-5 pt-3.5 pb-3">
            <div class="min-w-0">
              <h2 id="fab-contact-title" class="text-base sm:text-lg font-bold font-heading text-default">
                {title}
              </h2>
              <p class="text-xs text-muted mt-0.5 leading-snug">{subtitle}</p>
            </div>
            <button
              type="button"
              class="shrink-0 flex h-8 w-8 items-center justify-center rounded-full hover:bg-gray-100 dark:hover:bg-slate-800 transition-colors cursor-pointer"
              data-fab-contact-close
              aria-label={closeLabel}
            >
              <Icon name="tabler:x" class="w-4 h-4 pointer-events-none" aria-hidden="true" />
            </button>
          </div>

          <div class="flex min-h-0 flex-1 flex-col">
            <Form
              formId="fab-inquiry"
              compact
              stickyActions
              class="min-h-0 flex-1"
              button={button}
              description={description}
              inputs={inputs}
              textarea={textarea}
              disclaimer={disclaimer}
            />
            <p class="shrink-0 border-t border-gray-100 px-4 pb-3 pt-0 text-center text-xs text-muted dark:border-slate-800 sm:px-5">
              {preferChat}{' '}
              <a
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary underline underline-offset-2"
              >
                {waLabel}
              </a>
            </p>
          </div>
        </div>
      </div>
    </div>
  )
}

<script type:load>
  let btn = null;

  const initBackToTop = () => {
    btn = document.getElementById('back-to-top');
    if (!btn) return;

    const toggle = () => {
      if (window.scrollY > 400) {
        btn.classList.remove('opacity-0', 'invisible');
        btn.classList.add('opacity-100', 'visible');
      } else {
        btn.classList.add('opacity-0', 'invisible');
        btn.classList.remove('opacity-100', 'visible');
      }
    };

    window.removeEventListener('scroll', toggle);
    window.addEventListener('scroll', toggle);

    btn.removeEventListener('click', handleClick);
    btn.addEventListener('click', handleClick);

    toggle();
  };

  const handleClick = () => {
    if (window.location.hash) {
      history.replaceState(null, '', window.location.pathname + window.location.search);
    }
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  // —— Contact modal ——
  // Note: clicks on the X often hit the SVG (SVGElement), not HTMLElement — use Element.closest.
  let escBound = false;

  const openContactModal = () => {
    const modal = document.getElementById('fab-contact-modal');
    if (!modal) return;
    modal.classList.remove('hidden');
    document.body.classList.add('overflow-hidden');
    const firstInput = modal.querySelector('input, textarea');
    if (firstInput instanceof HTMLElement) {
      setTimeout(() => firstInput.focus(), 50);
    }
    // reCAPTCHA must render after the modal is visible (hidden parents break the widget)
    requestAnimationFrame(() => {
      document.dispatchEvent(new CustomEvent('inquiry-form:show-turnstile'));
    });
    window.setTimeout(() => {
      document.dispatchEvent(new CustomEvent('inquiry-form:show-turnstile'));
    }, 200);
  };

  const closeContactModal = () => {
    const modal = document.getElementById('fab-contact-modal');
    if (!modal) return;
    modal.classList.add('hidden');
    document.body.classList.remove('overflow-hidden');
  };

  const initContactModal = () => {
    const openBtn = document.getElementById('fab-contact-open');
    const modal = document.getElementById('fab-contact-modal');
    if (!openBtn || !modal) return;

    openBtn.onclick = (e) => {
      e.preventDefault();
      openContactModal();
    };

    // Bind every close control directly (backdrop + X button)
    modal.querySelectorAll('[data-fab-contact-close]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        closeContactModal();
      });
    });

    // Delegation fallback: SVG / path clicks still resolve via Element.closest
    modal.onclick = (e) => {
      const t = e.target;
      if (t instanceof Element && t.closest('[data-fab-contact-close]')) {
        e.preventDefault();
        closeContactModal();
      }
    };

    if (!escBound) {
      escBound = true;
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        const m = document.getElementById('fab-contact-modal');
        if (m && !m.classList.contains('hidden')) {
          closeContactModal();
        }
      });
    }
  };

  initBackToTop();
  initContactModal();

  document.addEventListener('astro:page-load', () => {
    initBackToTop();
    initContactModal();
  });
  document.addEventListener('astro:after-swap', () => {
    initBackToTop();
    initContactModal();
  });
</script>
