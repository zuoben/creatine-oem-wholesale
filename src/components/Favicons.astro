---
/**
 * Browser / home-screen icons for Hi Mah Jongg.
 * Files under /public only (stable absolute paths).
 */
const cacheBust = 'v7';
---

<link rel="icon" href={`/favicon.ico?${cacheBust}`} sizes="any" />
<link rel="icon" href={`/favicon.ico?${cacheBust}`} type="image/x-icon" />
<link rel="shortcut icon" href={`/favicon.ico?${cacheBust}`} type="image/x-icon" />
<link rel="icon" type="image/svg+xml" href={`/favicons/favicon.svg?${cacheBust}`} />
<link rel="icon" type="image/png" sizes="32x32" href={`/favicons/icon-32.png?${cacheBust}`} />
<link rel="icon" type="image/png" sizes="48x48" href={`/favicons/favicon-48.png?${cacheBust}`} />
<link rel="icon" type="image/png" sizes="192x192" href={`/favicons/icon-192.png?${cacheBust}`} />
<link rel="apple-touch-icon" sizes="180x180" href={`/favicons/apple-touch-icon.png?${cacheBust}`} />
<meta name="theme-color" content="#0f766e" />
