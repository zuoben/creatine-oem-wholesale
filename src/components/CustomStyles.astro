---
import '~/assets/styles/inter-latin.css';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  /*
   * Site theme aligned with /designer (teal-700 / slate neutrals).
   * primary  = teal-700 buttons & strong accents
   * secondary = teal-800 hover
   * accent   = teal-700 labels / taglines (teal-400 in dark)
   */
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    /* teal-700 / teal-800 */
    --aw-color-primary: rgb(15 118 110);
    --aw-color-secondary: rgb(17 94 89);
    --aw-color-accent: rgb(15 118 110);

    /* slate-900 / slate-600 body */
    --aw-color-text-heading: rgb(15 23 42);
    --aw-color-text-default: rgb(15 23 42);
    --aw-color-text-muted: rgb(71 85 105);
    --aw-color-bg-page: rgb(255 255 255);

    --aw-color-bg-page-dark: rgb(2 6 23);

    ::selection {
      background-color: rgb(153 246 228);
      color: rgb(15 23 42);
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    /* teal-600 / teal-500 — matches designer dark buttons */
    --aw-color-primary: rgb(13 148 136);
    --aw-color-secondary: rgb(20 184 166);
    /* teal-400 links & taglines */
    --aw-color-accent: rgb(45 212 191);

    --aw-color-text-heading: rgb(248 250 252);
    --aw-color-text-default: rgb(226 232 240);
    --aw-color-text-muted: rgb(148 163 184);
    --aw-color-bg-page: rgb(2 6 23);

    ::selection {
      background-color: rgb(15 118 110);
      color: snow;
    }
  }
</style>
