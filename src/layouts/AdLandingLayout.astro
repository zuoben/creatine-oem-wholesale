---
import Layout from '~/layouts/ADLayout.astro';
import Header from '~/components/widgets/Header.astro';
import WhatsAppLeadGate from '~/components/WhatsAppLeadGate.astro';
import type { Props as WhatsAppLeadGateProps } from '~/components/WhatsAppLeadGate.astro';

import type { MetaData } from '~/types';
import { getWhatsAppUrl } from '~/utils/whatsapp';

const whatsappUrl = getWhatsAppUrl();

export interface Props {
  metadata?: MetaData;
  showHeader?: boolean;
  disableLogoLink?: boolean;
  showToggleMenu?: boolean;
  /** Customize WhatsApp lead-gate form (product-specific fields, phone, copy) */
  waLead?: WhatsAppLeadGateProps;
}

const {
  metadata: metadataProp,
  showHeader = true,
  disableLogoLink = false,
  showToggleMenu = true,
  waLead,
} = Astro.props;
const adLandingMode = showHeader ? 'header' : 'bare';

/** Ad landing pages — never index */
const metadata: MetaData = {
  ...metadataProp,
  robots: {
    ...metadataProp?.robots,
    index: false,
    follow: metadataProp?.robots?.follow ?? false,
  },
};

const headerWhatsAppUrl = waLead?.whatsappUrl || whatsappUrl;
---

<script is:inline define:vars={{ adLandingMode }}>
  document.documentElement.dataset.adLanding = adLandingMode;
</script>

<Layout metadata={metadata} contactBtn={true}>
  {
    showHeader && (
      <Header
        links={[]}
        actions={[
          { text: 'Get Free Quote', href: '#contact', variant: 'primary' },
          { text: 'WhatsApp', href: headerWhatsAppUrl, target: '_blank' },
        ]}
        isSticky
        showToggleTheme={false}
        showToggleMenu={showToggleMenu}
        disableLogoLink={disableLogoLink}
        position="right"
      />
    )
  }
  <main class="min-w-0 max-w-[100vw] overflow-x-hidden">
    <slot />
  </main>
  <!-- WhatsApp CTAs: collect lead form first, then open WA -->
  <WhatsAppLeadGate {...(waLead ?? {})} />
</Layout>